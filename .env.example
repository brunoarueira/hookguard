PORT=3000
LOG_LEVEL=info

DATABASE_URL=postgres://hookguard:hookguard@localhost:5432/hookguard
REDIS_URL=redis://localhost:6379

# Shared API key required on GET /webhooks/:id/status (x-api-key header).
API_KEY=change-me

# Shared HMAC secret used to verify inbound webhook signatures.
# Signature header: x-webhook-signature: sha256=<hex hmac of raw body>
WEBHOOK_SECRET=change-me-too

# Retry policy for the processing worker.
MAX_ATTEMPTS=5
BACKOFF_BASE_MS=1000
